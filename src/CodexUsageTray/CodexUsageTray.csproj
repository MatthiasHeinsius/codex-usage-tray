<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <TargetLatestRuntimePatch>false</TargetLatestRuntimePatch>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CodexUsageTray</AssemblyName>
    <RootNamespace>CodexUsageTray</RootNamespace>
    <Version>2.2.3</Version>
    <AssemblyTitle>Codex Usage Tray</AssemblyTitle>
    <Product>Codex Usage Tray</Product>
    <Authors>Matthias Heinsius</Authors>
    <Description>Windows tray meter for Codex subscription limits and inference usage.</Description>
    <Copyright>Copyright (c) 2026 Matthias Heinsius</Copyright>
    <ApplicationIcon>Assets\CodexUsageTray.ico</ApplicationIcon>
    <RepositoryUrl>https://github.com/MatthiasHeinsius/codex-usage-tray</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodexUsageTray.ScreenshotGenerator" />
    <InternalsVisibleTo Include="CodexUsageTray.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Sigstore" />
    <EmbeddedResource Include="Updates\GitHubTufRoot.json"
                      LogicalName="CodexUsageTray.GitHubTufRoot.json" />
    <Content Include="..\..\LICENSE"
             Link="LICENSE.txt"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.txt"
             Link="THIRD-PARTY-NOTICES.txt"
             CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\LICENSE"
                      LogicalName="CodexUsageTray.LICENSE.txt" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt"
                      LogicalName="CodexUsageTray.THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>
</Project>
