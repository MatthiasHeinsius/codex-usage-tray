{
  "commandLineOptions": {
    "timeout": "10m",
    "zero-tests-policy": "strict"
  },
  "xUnit": {
    "culture": "invariant",
    "diagnosticMessages": true,
    "failSkips": true,
    "failWarns": true,
    "longRunningTestSeconds": 10,
    "methodDisplayOptions": "removeAsyncSuffix",
    "parallelMode": "collections",
    "preEnumerateTheories": true
  }
}
